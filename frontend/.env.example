# Clerk Authentication (from dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Sign-in/up redirects
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# API URL - use localhost for local development, AWS API Gateway URL for production
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Production (set via .env.production.local):
# NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-west-2.amazonaws.com
